{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "insights/v1/events/honeybadger-python/oban.lifeline_exception.json",
  "title": "Oban: lifeline_exception",
  "description": "Oban's lifeline loop, which rescues orphaned executing jobs, raised an exception.",
  "x-hb": {
    "notifiers": [
      "honeybadger-python"
    ],
    "category": "jobs",
    "component": "Oban"
  },
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "const": "oban.lifeline_exception"
    },
    "loop": {
      "type": "string",
      "const": "lifeline",
      "description": "Name of the Oban maintenance loop that raised."
    },
    "event": {
      "type": "string",
      "enum": [
        "oban.lifeline.rescue.exception"
      ],
      "description": "The underlying Oban telemetry event name.",
      "examples": [
        "oban.lifeline.rescue.exception"
      ]
    },
    "error_type": {
      "type": "string",
      "description": "Exception class name.",
      "examples": [
        "OperationalError"
      ]
    },
    "error_message": {
      "type": "string",
      "description": "Exception message.",
      "examples": [
        "connection to server was lost"
      ]
    },
    "duration": {
      "type": "number",
      "description": "Duration of the failed loop iteration in milliseconds.",
      "examples": [
        3.1415
      ]
    }
  },
  "required": [
    "event_type",
    "loop",
    "event"
  ]
}
